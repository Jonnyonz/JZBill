# Configuracion de la instalacion de JZBill. install-native.sh arma /etc/jzbill/jzbill.env;
# para desarrollo, copiar a .env en la raiz del repo. Lo que es del cliente (razones sociales,
# certificados de ARCA, SMTP) se carga despues desde la pagina, no aca.

# --- Base de datos: base y rol propios en el PostgreSQL del servidor ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=jzbill_db
POSTGRES_USER=jzbill
POSTGRES_PASSWORD=cambiar-por-una-clave-larga
DB_POOL_MAX=5

# --- Configuracion inicial: token para crear el primer administrador (openssl rand -hex 24) ---
SETUP_TOKEN=cambiar-por-un-token-largo

# --- Direccion publica con HTTPS del facturador (subdominio del cliente detras de Caddy) ---
PUBLIC_URL=https://factura.cliente.com

# --- Proxies de confianza para la IP real (X-Forwarded-For). Instalacion nativa: solo loopback ---
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Cookies Secure (true en produccion con HTTPS; false SOLO para probar por HTTP en la maquina local)
COOKIES_SECURE=true

# --- Puerto local del servicio (Caddy le habla a 127.0.0.1:APP_PORT) ---
APP_PORT=8050

# --- Login: intentos fallidos antes de bloquear (por IP + usuario y por IP sola), minutos de bloqueo
# y horas que dura una sesion ---
# MAX_LOGIN_ATTEMPTS=5
# MAX_LOGIN_ATTEMPTS_IP=20
# LOCKOUT_MINUTES=15
# SESSION_HOURS=8
# Largo minimo de las claves de los usuarios (el maximo es 128, fijo).
# PASSWORD_MIN_LENGTH=10

# --- Hash de claves (jztech_core, Argon2id). Por defecto el minimo de OWASP: 19 MiB por verificacion.
# En equipos con muy poca RAM se puede bajar la memoria (no menos de 12288 = 12 MiB). ---
# ARGON2_TIME_COST=2
# ARGON2_MEMORY_COST_KIB=19456
# ARGON2_PARALLELISM=1

# --- Instalacion: "nativa" (la escribe install-native.sh) o "desarrollo" ---
JZB_INSTALACION=desarrollo
